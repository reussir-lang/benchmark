// Std-collection workload on the ordered map from Reussir's std
// (std::collections::pure::wavlmap — a persistent WAVL tree).
//
// Build 1M MINSTD-keyed inserts over a 524287 keyspace, churn 1M
// insert/remove rounds (remove when draw % 4 == 3), sum 1M lookups
// (-1 for a miss), then fold the final map. During the two mutating
// phases a second draw per round decides retention: when it is
// divisible by 512 (3,933 times over the run) the current version is
// parked in slot (draw / 512) mod 8 of an eight-version ring, where
// it stays shared until that slot is next overwritten. Persistent maps
// pay path copies while a parked version is live; mutable maps pay a
// full copy per parked version. The checksum folds the final map and
// every ring slot, so retained versions stay live and verified:
// result = lookup-sum + sum over maps of (sum(key * 1000003 + value) +
// 7 * size). Final size 401,258; each ring slot ends holding a
// ~401k-entry version. Heavily shared tier: retention fires ~15x
// more often than ordered-map-shared, past the crossover where
// per-event full copies dominate a mutable representation.
//
// The build and churn rounds share one loop: round i of the combined
// 1M inserts value i in either phase (churn round j writes 1000000+j),
// and only the remove arm is churn-gated. The lookup phase draws once
// per round and retains nothing.

import core::intrinsic::array;
import std::collections::pure::wavlmap::WavlMap;
import std::option::Option;

fn lcg(x : i64) -> i64 {
    (x * 48271) % 2147483647
}

fn fold_one(m : WavlMap<i64, i64>, acc : i64) -> i64 {
    m.fold_left(acc, |a, k, v| a + k * 1000003 + v) + 7 * (m.len() as i64)
}

fn fold_ring(ring : [WavlMap<i64, i64>; 8], i : i64, acc : i64) -> i64 {
    if i == 8 {
        acc
    } else {
        fold_ring(ring, i + 1, fold_one(array::get(ring, i), acc))
    }
}

fn lookups(i : i64, x : i64, m : WavlMap<i64, i64>, acc : i64) -> i64 {
    if i == 1000000 {
        acc
    } else {
        let x1 = lcg(x);
        lookups(i + 1, x1, m, acc + m.get(x1 % 524287).unwrap_or(0 - 1))
    }
}

fn mutate(
    i : i64,
    x : i64,
    m : WavlMap<i64, i64>,
    ring : [WavlMap<i64, i64>; 8]
) -> i64 {
    if i == 2000000 {
        let acc = lookups(0, x, m, 0);
        fold_ring(ring, 0, fold_one(m, acc))
    } else {
        let x1 = lcg(x);
        let k = x1 % 524287;
        let m1 = if i >= 1000000 && x1 % 4 == 3 {
            m.remove(k)
        } else {
            m.insert(k, i)
        };
        let x2 = lcg(x1);
        if x2 % 512 == 0 {
            let kept = m1;
            let ring2 = array::set(ring, (x2 / 512) % 8, kept);
            mutate(i + 1, x2, kept, ring2)
        } else {
            mutate(i + 1, x2, m1, ring)
        }
    }
}

fn map_test() -> i64 {
    let ring = array::splat<[WavlMap<i64, i64>; 8]>(WavlMap::new());
    mutate(0, 1, WavlMap::new(), ring)
}

extern "C" trampoline "map_test_ffi" = map_test;
