// Std-collection workload on the hash map from Reussir's std
// (std::collections::pure::hashmap — a persistent radix-32 HAMT keyed
// by the pure FastHasher with its default seed).
//
// Zipfian mixed-op workload: keys follow an integer-only octave Zipf
// (theta ~ 1) — a stratum s drawn uniform in [0, 24), then a key
// uniform in [2^s, 2^(s+1)), so every octave carries equal mass and
// per-key probability decays as 1/key. No floating point, so the
// distribution is bit-identical in every language. 8M rounds, each
// drawing op, stratum, key from one MINSTD stream: 9/16 insert,
// 5/16 delete, 2/16 lookup (sum, -1 on miss). Hot octaves saturate
// (the hottest key sees ~187k overwrites), the cold tail stays sparse,
// and deletes land on present keys ~48% of the time.
//
// Linear variant: exactly one live version — the map handle is
// threaded linearly through every round and nothing is retained, so
// uniqueness-driven reuse updates nodes in place throughout. The
// checksum folds the final map:
// result = lookup-sum + sum(key * 31 + value) + 7 * size.
// Final size 1,120,773.
//
// Std ships no Hash impl for primitive keys, so the logical i64 key
// rides in a [value] newtype whose Hash feeds the i64 to the hasher —
// the same shape the std integration tests use.

import std::collections::pure::hashmap::HashMap;
import std::hash::Hash;
import std::hash::Hasher;
import std::option::Option;

pub struct [value] Key {
    id : i64
}

impl PartialEq for Key {
    fn eq(self : Self, other : Self) -> bool { self.id == other.id }
}

impl Eq for Key {}

impl Hash for Key {
    fn hash<H : Hasher>(self : Self, state : H) -> H {
        state.write_i64(self.id)
    }
}

fn lcg(x : i64) -> i64 {
    (x * 48271) % 2147483647
}

fn fold_one(m : HashMap<Key, i64>, acc : i64) -> i64 {
    m.fold_left(acc, |a, k, v| a + k.id * 31 + v) + 7 * (m.len() as i64)
}

fn ops(i : i64, x : i64, m : HashMap<Key, i64>, acc : i64) -> i64 {
    if i == 8000000 {
        fold_one(m, acc)
    } else {
        let x1 = lcg(x);
        let op = x1 % 16;
        let x2 = lcg(x1);
        let s = x2 % 24;
        let x3 = lcg(x2);
        let k = Key { id: (1 << s) + (x3 % (1 << s)) };
        let m2 = if op < 9 {
            m.insert(k, i)
        } else {
            if op < 14 { m.remove(k) } else { m }
        };
        let acc2 = if op < 14 {
            acc
        } else {
            acc + m2.get(k).unwrap_or(0 - 1)
        };
        ops(i + 1, x3, m2, acc2)
    }
}

fn map_test() -> i64 {
    ops(0, 1, HashMap::new(), 0)
}

extern "C" trampoline "map_test_ffi" = map_test;
