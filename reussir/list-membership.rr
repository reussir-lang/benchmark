// list-membership: 40000 membership queries against one 10000-element list
// that the caller keeps between queries (reussir-lang/reussir#762). Every
// query only reads the list; half of them miss and walk all of it.

enum List {
    Nil,
    Cons(i64, List)
}

fn mem(x: i64, xs: List) -> bool {
    match xs {
        List::Nil => false,
        List::Cons(y, ys) => if x == y { true } else { mem(x, ys) }
    }
}

// [1 .. n]
fn build(n: i64, acc: List) -> List {
    if n == 0 { acc } else { build(n - 1, List::Cons{n, acc}) }
}

fn search(q: i64, n: i64, xs: List, hits: i64) -> i64 {
    if q == 0 {
        hits
    } else {
        let x = (q * 7919) % (2 * n) + 1;
        if mem(x, xs) { search(q - 1, n, xs, hits + 1) } else { search(q - 1, n, xs, hits) }
    }
}

fn membership(n: i64, queries: i64) -> i64 {
    search(queries, n, build(n, List::Nil), 0)
}

extern "C" trampoline "membership_ffi" = membership;
