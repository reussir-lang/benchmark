// Std-collection workload on an ordered map. Morphic's library ships no
// ordered map, so this uses lib/ordmap.mor, a persistent red-black tree
// written for the suite (Okasaki insert, Kahrs delete). Matches
// koka/ordered-map-shared.kk.
//
// Build 1M MINSTD-keyed inserts over a 524287 keyspace, churn 1M
// insert/remove rounds (remove when draw % 4 == 3), sum 1M lookups
// (-1 for a miss), then fold the final map. During the two mutating
// phases a second draw per round decides retention: when it is
// divisible by 8192 (265 times over the run) the current version is
// parked in slot (draw / 8192) mod 8 of an eight-version ring, where
// it stays shared until that slot is next overwritten. The persistent
// tree shares every node with a parked version until updates path-copy
// them away. The checksum folds the final map and every ring slot, so
// retained versions stay live and verified:
// result = lookup-sum + sum over maps of (sum(key * 1000003 + value) +
// 7 * size). Final size 401,258; each ring slot ends holding a
// ~401k-entry version.
//
// The build and churn rounds share one loop: round i of the combined
// 2M inserts value i in either phase (churn round j writes 1000000+j),
// and only the remove arm is churn-gated. The lookup phase draws once
// per round and retains nothing.

module Core = file "lib/core/core.mor"
  expose {
    module Io expose { writeln },
    module String expose { i64_to_string, concat },
    module Option,
    module Array,
  }

module OrdMap = file "lib/ordmap.mor" with { Core } expose { OrdMap }

rem(a: I64, b: I64): I64 = a - b * (a / b)

lcg(x: I64): I64 = rem(x * 48271, 2147483647)

fold_one(m: OrdMap I64, acc: I64): I64 =
  OrdMap.foldl(m, acc, \(a, k, v) -> a + k * 1000003 + v) + 7 * OrdMap.size(m)

fold_ring(ring: Array (OrdMap I64), acc: I64): I64 =
  Array.foldl(ring, acc, \(a, m) -> fold_one(m, a))

lookups(i: I64, x: I64, m: OrdMap I64, acc: I64): I64 =
  if i = 1000000 { acc } else {
    let x1 = lcg(x) in
    let v = Option.or_default(OrdMap.get(m, rem(x1, 524287)), -1) in
    lookups(i + 1, x1, m, acc + v)
  }

// Returns the final draw, the final map, and the retention ring.
mutate(i: I64, x: I64, m: OrdMap I64, ring: Array (OrdMap I64))
  : (I64, OrdMap I64, Array (OrdMap I64)) =
  if i = 2000000 { (x, m, ring) } else {
    let x1 = lcg(x) in
    let k = rem(x1, 524287) in
    let m1 =
      if (i >= 1000000) && (rem(x1, 4) = 3) { OrdMap.remove(m, k) }
      else { OrdMap.insert(m, k, i) } in
    let x2 = lcg(x1) in
    if rem(x2, 8192) = 0 {
      mutate(i + 1, x2, m1, Array.set(ring, rem(x2 / 8192, 8), m1))
    } else {
      mutate(i + 1, x2, m1, ring)
    }
  }

proc main(): () =
  let (x, m, ring) = mutate(0, 1, OrdMap.empty, Array.fill(8, OrdMap.empty)) in
  let c = fold_ring(ring, fold_one(m, lookups(0, x, m, 0))) in
  let n = OrdMap.size(m) in
  if (c = 948266134564763663) && (n = 401258) {
    ()
  } else {
    do writeln(concat("FAIL: expected 948266134564763663 (size 401258), got ",
      concat(i64_to_string(c), concat(" (size ", concat(i64_to_string(n), ")"))))) then
    panic("wrong result\n")
  }
