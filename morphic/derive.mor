// derive: one symbolic derivative chain -- differentiate x^x ten times with
// the simplifying smart constructors, then report the right spine depth of
// the result. Matches koka/derive.kk (itself adapted from Lean's IFL19
// deriv benchmark): one round, `repeat_test(1, 0)` = right_depth + 0.
//
// Deviation: Koka's constants are arbitrary-precision `int`; Morphic has no
// big integers, so `Val` holds an I64 like the Reussir and Rust ports (no
// constant in this chain comes close to overflowing). `pown` follows the
// Reussir/Rust ports: a negative exponent yields 0 instead of looping.

module Core = file "lib/core/core.mor"
  expose {
    module Io expose { writeln },
    module String expose { i64_to_string, concat },
  }

type Expr {
  Val(I64),
  Var(I64),
  Add(Expr, Expr),
  Mul(Expr, Expr),
  Pow(Expr, Expr),
  Ln(Expr),
}

pow_rec(acc: I64, a: I64, b: I64): I64 =
  if b = 0 { acc } else { pow_rec(a * acc, a, b - 1) }

pown(a: I64, b: I64): I64 =
  if b < 0 { 0 } else { pow_rec(1, a, b) }

add(n0: Expr, m0: Expr): Expr =
  match (n0, m0) {
    (Val(n), Val(m)) -> Val(n + m),
    (Val(0), f) -> f,
    (f, Val(0)) -> f,
    (f, Val(n)) -> add(Val(n), f),
    (Val(n), Add(Val(m), f)) -> add(Val(n + m), f),
    (f, Add(Val(n), g)) -> add(Val(n), add(f, g)),
    (Add(f, g), h) -> add(f, add(g, h)),
    (f, g) -> Add(f, g),
  }

mul(n0: Expr, m0: Expr): Expr =
  match (n0, m0) {
    (Val(n), Val(m)) -> Val(n * m),
    (Val(0), _) -> Val(0),
    (_, Val(0)) -> Val(0),
    (Val(1), f) -> f,
    (f, Val(1)) -> f,
    (f, Val(n)) -> mul(Val(n), f),
    (Val(n), Mul(Val(m), f)) -> mul(Val(n * m), f),
    (f, Mul(Val(n), g)) -> mul(Val(n), mul(f, g)),
    (Mul(f, g), h) -> mul(f, mul(g, h)),
    (f, g) -> Mul(f, g),
  }

powr(m0: Expr, n0: Expr): Expr =
  match (m0, n0) {
    (Val(m), Val(n)) -> Val(pown(m, n)),
    (_, Val(0)) -> Val(1),
    (f, Val(1)) -> f,
    (Val(0), _) -> Val(0),
    (f, g) -> Pow(f, g),
  }

ln(n: Expr): Expr =
  match n {
    Val(1) -> Val(0),
    f -> Ln(f),
  }

d(x: I64, e: Expr): Expr =
  match e {
    Val(_) -> Val(0),
    Var(y) -> if x = y { Val(1) } else { Val(0) },
    Add(f, g) -> add(d(x, f), d(x, g)),
    Mul(f, g) -> add(mul(f, d(x, g)), mul(g, d(x, f))),
    Pow(f, g) ->
      mul(powr(f, g), add(mul(mul(g, d(x, f)), powr(f, Val(-1))), mul(ln(f), d(x, g)))),
    Ln(f) -> mul(d(x, f), powr(f, Val(-1))),
  }

right_depth(e: Expr): I64 =
  match e {
    Val(_) -> 1,
    Var(_) -> 1,
    Add(_, g) -> right_depth(g) + 1,
    Mul(_, g) -> right_depth(g) + 1,
    Pow(_, g) -> right_depth(g) + 1,
    Ln(f) -> right_depth(f) + 1,
  }

nest_aux(s: I64, f: (I64, Expr) -> Expr, n: I64, x: Expr): Expr =
  if n = 0 { x } else {
    let y = f(s - n, x) in
    nest_aux(s, f, n - 1, y)
  }

nest(f: (I64, Expr) -> Expr, n: I64, e: Expr): Expr = nest_aux(n, f, n, e)

deriv(i: I64, f: Expr): Expr = d(0, f)

derive_test(i: I64): I64 =
  let x = Var(0) in
  let f = powr(x, x) in
  let res = nest(deriv, 10, f) in
  right_depth(res) + i

repeat_test(r: I64, acc: I64): I64 =
  if r = 0 { acc } else { repeat_test(r - 1, acc + derive_test(r - 1)) }

proc main(): () =
  let n = repeat_test(1, 0) in
  if n = 524 {
    ()
  } else {
    do writeln(concat("FAIL: expected 524, got ", i64_to_string(n))) then
    panic("wrong result\n")
  }
