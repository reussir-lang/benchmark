// heap-array: binary min-heap maintenance under a Gaussian workload. A heap
// of 65535 I64 values in an array is built by insertion (set the next slot,
// sift up) from an Irwin-Hall stream (each draw is the sum of 12 consecutive
// MINSTD outputs), then 6.5M rounds of unconditional replace-top (evict the
// minimum, add a fresh draw to it, sift down). The checksum is the running
// sum of evicted minima plus the final heap contents, mod 1e9+7. Matches
// reussir/heap.rr and lean/heap.lean: the array is threaded linearly through
// the recursion, so Morphic's copy-on-write arrays update in place, and
// build's base case continues into maintain directly, so no function returns
// an (array, lcg-state) pair. Morphic has no `%` operator, so remainders are
// written `a - b * (a / b)`.

module Core = file "lib/core/core.mor"
  expose {
    module Io expose { writeln },
    module String expose { i64_to_string, concat },
    module Array,
  }

rem(a: I64, b: I64): I64 = a - b * (a / b)

lcg(x: I64): I64 = rem(x * 48271, 2147483647)

sift_up(a: Array I64, i: I64): Array I64 =
  if i = 0 { a } else {
    let p = (i - 1) / 2 in
    let vi = Array.get(a, i) in
    let vp = Array.get(a, p) in
    if vi < vp { sift_up(Array.set(Array.set(a, i, vp), p, vi), p) } else { a }
  }

sift_down(a: Array I64, i: I64): Array I64 =
  let l = 2 * i + 1 in
  if l >= 65535 { a } else {
    let r = l + 1 in
    let vl = Array.get(a, l) in
    let c = if r < 65535 && Array.get(a, r) < vl { r } else { l } in
    let vc = Array.get(a, c) in
    let vi = Array.get(a, i) in
    if vc < vi { sift_down(Array.set(Array.set(a, i, vc), c, vi), c) } else { a }
  }

heap_sum(a: Array I64, k: I64, acc: I64): I64 =
  if k = 65535 { acc } else {
    heap_sum(a, k + 1, rem(acc + Array.get(a, k), 1000000007))
  }

maintain(a: Array I64, x: I64, m: I64, acc: I64): I64 =
  if m = 0 { rem(acc + heap_sum(a, 0, 0), 1000000007) } else {
    let x1 = lcg(x) in
    let x2 = lcg(x1) in
    let x3 = lcg(x2) in
    let x4 = lcg(x3) in
    let x5 = lcg(x4) in
    let x6 = lcg(x5) in
    let x7 = lcg(x6) in
    let x8 = lcg(x7) in
    let x9 = lcg(x8) in
    let x10 = lcg(x9) in
    let x11 = lcg(x10) in
    let x12 = lcg(x11) in
    let g = x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 + x12 in
    let top = Array.get(a, 0) in
    maintain(
      sift_down(Array.set(a, 0, top + g), 0),
      x12,
      m - 1,
      rem(acc + top, 1000000007),
    )
  }

build(a: Array I64, k: I64, x: I64, m: I64): I64 =
  if k = 65535 { maintain(a, x, m, 0) } else {
    let x1 = lcg(x) in
    let x2 = lcg(x1) in
    let x3 = lcg(x2) in
    let x4 = lcg(x3) in
    let x5 = lcg(x4) in
    let x6 = lcg(x5) in
    let x7 = lcg(x6) in
    let x8 = lcg(x7) in
    let x9 = lcg(x8) in
    let x10 = lcg(x9) in
    let x11 = lcg(x10) in
    let x12 = lcg(x11) in
    let g = x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 + x12 in
    build(sift_up(Array.set(a, k, g), k), k + 1, x12, m)
  }

heap_test(m: I64): I64 = build(Array.fill(65535, 0), 0, 20260711, m)

proc main(): () =
  let v = heap_test(6500000) in
  if v = 558972311 {
    ()
  } else {
    do writeln(concat("FAIL: expected 558972311, got ", i64_to_string(v))) then
    panic("wrong result\n")
  }
